# For local desktop development no configuration is required.
# For phones / native builds, use a reachable LAN or deployed server:
# VITE_SERVER_URL=ws://192.168.1.10:2567
# Production / native builds should use TLS:
# VITE_SERVER_URL=wss://your-game.fly.dev
# Optional anonymous cloud profile (enable Anonymous Sign-ins in Supabase):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
