{
  "name": "fart-together-mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "tsc --noEmit -p packages/server && tsc --noEmit -p packages/client",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run start -w server",
    "generate:track": "tsx tools/generate-track.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@types/node": "^22.14.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3"
  }
}
