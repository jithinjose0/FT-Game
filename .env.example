# Server (copy to .env at the repository root)
PORT=2567
## Managed Metered TURN alternative (preferred over the shared testing relay).
# VOICE_METERED_HOST=your-app.metered.live
# VOICE_METERED_API_KEY=your-server-only-turn-rest-api-key
DATA_DIR=./data
# Optional crew voice NAT traversal (coturn use-auth-secret / static-auth-secret).
# VOICE_STUN_URLS=stun:your-relay.example.com:3478
# VOICE_TURN_URLS=turn:your-relay.example.com:3478,turns:your-relay.example.com:5349
# VOICE_TURN_SECRET=your-coturn-shared-secret
# Optional cloud persistence. Never put the service-role key in VITE_* variables.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
